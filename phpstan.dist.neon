includes:
	- vendor/webifycms/dev-tools/phpstan-default.neon
	- vendor/phpat/phpat/extension.neon

parameters:
	level: 10
	paths:
		- src
		- test
	excludePaths:
		- vendor
	reportUnmatchedIgnoredErrors: false

services:
	-
		class: Webify\User\Test\Architecture\DomainSpecification
		tags:
			- phpat.test
	-
		class: Webify\User\Test\Architecture\AuthenticationSpecification
		tags:
			- phpat.test
	-
		class: Webify\User\Test\Architecture\AuthorizationSpecification
		tags:
			- phpat.test
	-
		class: Webify\User\Test\Architecture\IdentitySpecification
		tags:
			- phpat.test